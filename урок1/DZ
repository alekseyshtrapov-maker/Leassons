# Камера контроля СИМ на пешеходных зонах << контролировать скорость, дистанцию << контролировать скорость не более 7 км/ч. <<контролировать дистанцию не менн 1 метра
# Скорость <=7 км/ч. (and)

while True:
    Скорость =  float(input("Скорость > "))

    if Скорость >= 7 and Скорость <= 10:
        print("Нет нарушений")
    elif Скорость < 7:
        print ("Низкая скорости")
    else:
        print ("Высокая скорость")
