def среднее_из_трех_чисел(А, Б, В):
    мин = 100

    if А < мин:
        мин = А
    if Б < мин:
        мин = Б
    if В < мин:
        мин = В
    
    макс = 0

    if А > макс:
        макс = А
    if Б > макс:
        макс = Б
    if В > макс:
        макс = В
    
    if мин != А and макс != А:
        return А
    if мин != Б and макс != Б:
        return Б
    if мин != В and макс != В:
        return В


СР = среднее_из_трех_чисел(8, 42, 32)

print(СР, СР*2, СР*40)